## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.log

# VS Code folders
.vscode/

# Rider
.idea/

# Visual Studio folder
.vs/

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Microsoft Azure Build Output
csx/
*.build.csdef

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# DotCover
*.dotCover

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# Coverlet
coverage*.json
coverage*.xml
coverage*.info

# StyleCop
StyleCopReport.xml

# MSTest
TestResults/
*.trx
*.vsmdi

# DotTrace
*.dotTrace

# TeamCity
_TeamCity*

# Rider settings
.idea/

# JetBrains Rider logs
.idea/.idea.log

# Local history for Visual Studio
.localhistory/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# OS generated files
.DS_Store
*.swp

# dotenv environment files
.env
.env.*

# Temporary files
~$*
